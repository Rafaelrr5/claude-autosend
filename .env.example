# Copy to .env and adjust. All values are optional.

# Port the web UI listens on.
PORT=3847

# Bind address. Keep 127.0.0.1 — this server runs shell commands on your
# machine, so exposing it on 0.0.0.0 hands that capability to your network.
HOST=127.0.0.1

# Directory Claude Code is launched in. Defaults to the project directory.
# CLAUDE_WORKDIR=C:\Users\you\projects\my-repo

# Extra flags forwarded to the `claude` CLI. Empty by default.
# Setting --dangerously-skip-permissions lets scheduled prompts run unattended
# without approval prompts. Understand the risk before enabling it.
# CLAUDE_FLAGS=--dangerously-skip-permissions

# Full path to claude.exe. Normally found on PATH (including the npm install
# location); the npm claude.ps1/claude.cmd shims are bypassed on purpose.
# CLAUDE_BIN=C:\Users\you\AppData\Roaming\npm\node_modules\@anthropic-ai\claude-code\bin\claude.exe

# IANA timezone used to interpret the scheduled HH:MM time.
TZ_NAME=America/Sao_Paulo

# JSON file pending schedules are written to, so a restart re-arms them.
# Defaults to schedules.json in the project directory.
# DATA_FILE=C:\Users\you\claude-autosend-schedules.json
